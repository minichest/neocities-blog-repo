<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  
  <!-- Points flawlessly to your central Neocities asset directory -->
  <link rel="stylesheet" href="/res/css/ice-cap-post.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/bulma.min.css">
</head>
<!-- Applying your custom 'post-page' body hook class from your CSS file -->
<body class="post-page">

  <!-- Main container wrapper for your markdown text -->
  <main class="ice-cap-container">
    {{ content | safe }}
  </main>
</body>
</html>
